<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="stop_light_post">
    <static>true</static>
    
    <!-- Main post -->
    <link name="post">
      <pose>0 0 0 0 0 0</pose>
      
      <visual name="post_visual">
        <pose>0 0 1.5 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>3.0</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
      
      <collision name="post_collision">
        <pose>0 0 1.5 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>3.0</length>
          </cylinder>
        </geometry>
      </collision>
    </link>
    
    <!-- Traffic light housing -->
    <link name="light_box">
      <pose>0 0 3.2 0 0 0</pose>
      
      <visual name="box_visual">
        <geometry>
          <box>
            <size>0.25 0.15 0.7</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
      
      <!-- Red light (top) -->
      <visual name="red">
        <pose>0 0 0.25 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.06</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.3 0 0 1</ambient>
          <diffuse>0.8 0 0 1</diffuse>
          <emissive>0.3 0 0 1</emissive>
        </material>
      </visual>
      
      <!-- Yellow light (middle) -->
      <visual name="yellow">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.06</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.3 0.3 0 1</ambient>
          <diffuse>0.8 0.8 0 1</diffuse>
          <emissive>0.3 0.3 0 1</emissive>
        </material>
      </visual>
      
      <!-- Green light (bottom) -->
      <visual name="green">
        <pose>0 0 -0.25 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.06</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0 0.3 0 1</ambient>
          <diffuse>0 0.8 0 1</diffuse>
          <emissive>0 0.3 0 1</emissive>
        </material>
      </visual>
      
      <collision name="box_collision">
        <geometry>
          <box>
            <size>0.25 0.15 0.7</size>
          </box>
        </geometry>
      </collision>
    </link>
    
    <!-- Fixed joint between post and light box -->
    <joint name="post_to_box" type="fixed">
      <parent>post</parent>
      <child>light_box</child>
    </joint>
  </model>
</sdf>
